# === 嫄곕옒??===
UPBIT_ACCESS_KEY=your_upbit_access_key
UPBIT_SECRET_KEY=your_upbit_secret_key

# === ?곗씠???섏쭛 ===
TAVILY_API_KEY=tvly-your_tavily_api_key

# === ?곗씠?곕쿋?댁뒪 ===
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_DB_URL=postgresql://postgres.[your-project-ref]:[password]@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres

# === ?뚮┝ ===
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_USER_ID=your_telegram_user_id

# === 癒몄떊 ?앸퀎 (4? ?숈떆 ?ㅽ뻾 ??留ㅻℓ DB 以묐났 諛⑹?) ===
# MACHINE_NAME: 癒몄떊蹂?怨좎쑀 ?앸퀎??(DB ?덉퐫?쒖뿉 ?쒓렇)
#   pc128=蹂묒썝128GB, pc36=吏?6GB, mac-mini=二쇰ℓ留? jsh8603=?꾨뱾
# MACHINE_ROLE: primary=留ㅻℓ DB 湲곕줉, worker=?숈뒿/?덈젴留?
MACHINE_NAME=pc128
MACHINE_ROLE=primary

# === ?덉쟾?μ튂 ===
DRY_RUN=true
MAX_TRADE_AMOUNT=100000
MIN_TRADE_AMOUNT=5000
MAX_DAILY_TRADES=3
MAX_POSITION_RATIO=0.5
MIN_TRADE_INTERVAL_HOURS=4
EMERGENCY_STOP=false

# === ?⑦? ?꾩슜 (short_term_trader.py) ===
SHORT_TERM_BUDGET=500000
SHORT_TERM_MAX_TRADE=200000
SHORT_TERM_MAX_DAILY=10
SHORT_TERM_STOP_LOSS=0.8
SHORT_TERM_TAKE_PROFIT=1.5
SHORT_TERM_MAX_HOLD_MIN=30

# === LLM-RL ?섏씠釉뚮━??遺꾩궛 ?쒖뒪??===
GEMINI_API_KEY=your_gemini_api_key

# ZeroMQ ?듭떊 (遺꾩궛 ?몃뱶 媛?
ZMQ_MAIN_BRAIN_HOST=127.0.0.1
ZMQ_MAIN_BRAIN_PORT=5555
ZMQ_PUB_PORT=5556
ZMQ_HEARTBEAT_INTERVAL=30
ZMQ_REQUEST_TIMEOUT=30000

# RAG ?꾨쿋??
RAG_EMBEDDING_MODEL=text-embedding-004
RAG_EMBEDDING_DIM=768
RAG_TOP_K=5

# === X(?몄쐞?? ?쒓렇???섏쭛 ===
X_USERNAME=your_x_username
X_PASSWORD=your_x_password
X_EMAIL=your_x_email

# === CryptoCompare ?뚯뀥 媛먯꽦 (臾대즺 ??諛쒓툒: https://min-api.cryptocompare.com) ===
CRYPTOCOMPARE_API_KEY=your_cryptocompare_api_key

# === ?뚰듃??(AltRang) -- ?먭린?? DB留?蹂댁〈 ===
SB_EXCHANGE=binance                      # binance ?먮뒗 upbit
BINANCE_API_KEY=your_binance_api_key
BINANCE_API_SECRET=your_binance_api_secret
SB_DRY_RUN=true
SB_EMERGENCY_STOP=false
SB_FUNDING_MIN_RATE=0.0005
SB_FUNDING_MAX_COINS=5
SB_FUNDING_POSITION_USDT=200
SB_FUNDING_MAX_TOTAL_USDT=1000
SB_ROTATION_UNIVERSE=30
SB_ROTATION_TOP_N=5
SB_ROTATION_INTERVAL_MIN=240
SB_ROTATION_POSITION_USDT=200
SB_ROTATION_MAX_TOTAL_USDT=1000
SB_ROTATION_STOP_LOSS=5.0
SB_ROTATION_TAKE_PROFIT=15.0
SB_USE_BNB_FEE=true

# === 蹂?숈꽦 ?뚰뙆 (Volatility Breakout, Larry Williams) ===
# 留ㅼ씪 BREAKOUT_TRADE_TIME_KST ?뺢컖???먮룞 留ㅼ닔/24h 泥?궛
# 蹂꾨룄 monitor cron??留?15遺??먯젅(-2%) 媛먯떆
BREAKOUT_ENABLED=true
BREAKOUT_DRY_RUN=true            # 泥?1二?寃利???false ?꾪솚
BREAKOUT_K=0.7                   # ?뚰뙆 K媛?(0.5~0.7, 諛깊뀒?ㅽ듃 0.7 理쒓퀬)
BREAKOUT_BUY_AMOUNT=300000       # 1??留ㅼ닔 KRW
BREAKOUT_STOP_LOSS_PCT=-2.0      # ?먯젅 -2%
BREAKOUT_TIME_EXIT_HOURS=24      # 24h ?쒓컙 泥?궛
BREAKOUT_TRADE_TIME_KST=10:00    # 留ㅼ닔/泥?궛 ?쒓컖

# === LLM determinism / circuit-breaker (SO-4/SO-5/SO-8) ===
# GEMINI_TEMPERATURE=0 ensures deterministic decisions; >0 = non-reproducible, not recommended
GEMINI_TEMPERATURE=0
# GEMINI_DAILY_CAP: max daily LLM calls before heuristic fallback
GEMINI_DAILY_CAP=50
# GEMINI_LATENCY_BUDGET: LLM response budget (seconds); exceeded = heuristic direct
GEMINI_LATENCY_BUDGET=30
# R2_DRIFT_THRESHOLD: allowed exchange<->DB balance drift ratio (0.05 = 5%)
R2_DRIFT_THRESHOLD=0.05
